# Copy to .env.production (gitignored) before running `npm run build` for a
# real deployment. Vite bakes these in at build time — there is no runtime
# env var support for a static build, so a URL change means a rebuild.

# The public HTTPS URL of the CodeIgniter API, as the browser will reach it
# (i.e. through Nginx/Apache, not the internal PHP-FPM address).
VITE_API_URL=https://api.yourdomain.com/api/v1
