#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# development | testing | production
# production disables the debug toolbar, tightens the error handler
# (no stack traces in API responses — see ApiExceptionHandler), and
# raises the log threshold to 4 (errors and above only).

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# The API's own public HTTPS URL (what Nginx/Apache terminates TLS for
# and proxies to this app) — NOT the frontend's URL.
app.baseURL = 'https://api.yourdomain.com/'

# Redirect any HTTP request to HTTPS and send HSTS. Only turn this on
# once TLS is actually terminated in front of this app (see
# deploy/nginx.conf.example) — with no HTTPS in place this will just
# redirect-loop.
app.forceGlobalSecureRequests = true

# Required when running behind Nginx/Apache as a reverse proxy, or
# every request will appear to come from the proxy's own IP — which
# breaks both the rate limiter (RateLimitFilter, keyed by client IP)
# and any IP-based logging. Match this to your actual proxy's address.
# app.proxyIPs[10.0.0.5] = X-Forwarded-For

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Use a dedicated production DB user with only the privileges this app
# actually needs (SELECT/INSERT/UPDATE/DELETE on pos_system.* — no
# CREATE/DROP/GRANT, and no access to other schemas). See
# deploy/create-production-db-user.sql for the exact GRANT statement.
# Never reuse the local dev credentials in production.

database.default.hostname = 127.0.0.1
database.default.database = pos_system
database.default.username = pos_system_app
database.default.password = CHANGE_ME_use_a_generated_32+_char_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate a fresh key for production — never reuse the one from a dev
# .env. `php spark key:generate` prints one in the correct format.

encryption.key = CHANGE_ME_run_php_spark_key:generate

#--------------------------------------------------------------------
# AUTH / JWT
#--------------------------------------------------------------------
# Generate independently from the encryption key and from each other —
# `openssl rand -hex 32` for each. Rotating JWT_SECRET invalidates
# every access/refresh token currently outstanding (every user gets
# logged out), so treat it like any other production secret: stored in
# your platform's secret manager / injected at deploy time, never
# committed, never shared between environments.

JWT_SECRET = CHANGE_ME_openssl_rand_hex_32
SESSION_SECRET = CHANGE_ME_openssl_rand_hex_32_different_from_jwt_secret

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# The frontend's real HTTPS origin(s) — comma-separated if there's more
# than one (e.g. a staging + production frontend hitting the same
# API). See app/Config/Cors.php — dev's localhost origins are always
# allowed in addition to this, no need to list them here.

CORS_ALLOWED_ORIGIN = https://app.yourdomain.com

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 4 = Runtime Errors and above only (the Config\Logger default for
# production already matches this — uncomment only to override it).

# logger.threshold = 4
